{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(npm run *)",
      "Bash(npm *)",
      "Bash(git *)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(.env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(*.tsx)",
        "hooks": [
          { "type": "command", "command": "npm run lint -- --quiet $CLAUDE_FILE_PATHS 2>/dev/null; true" }
        ]
      },
      {
        "matcher": "Write(*.ts)",
        "hooks": [
          { "type": "command", "command": "npm run lint -- --quiet $CLAUDE_FILE_PATHS 2>/dev/null; true" }
        ]
      }
    ]
  }
}
